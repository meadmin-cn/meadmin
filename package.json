  "devDependencies": {
    "@commitlint/cli": "^17.0.3",
    "@commitlint/config-conventional": "^17.0.3",
    "@midwayjs/mock": "^3.20.11",
    "@release-it/conventional-changelog": "^8.0.1",
    "@types/lodash-es": "^4.17.12",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.11",
    "c8": "^8.0.1",
    "cross-env": "^7.0.3",
    "lerna": "^8.2.3",
    "mocha": "^10.8.2",
    "mwts": "^1.3.0",
    "mwtsc": "^1.15.2",
    "prettier": "2.8.8",
    "release-it": "^17.0.1",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20.13.1"
  },
  "scripts": {
    "start": "cross-env NODE_ENV=production node ./bootstrap.js",
    "dev": "cross-env NODE_ENV=local  mwtsc  --cleanOutDir --watch --run @midwayjs/mock/app",
    "test": "cross-env NODE_ENV=unittest TSX_TSCONFIG_PATH=./test/tsconfig.json mocha",
    "cov": "cross-env c8 --all --reporter=text --reporter=lcovonly npm run test",
    "lint": "mwts check",
    "lint:fix": "mwts fix",
    "ci": "npm run cov",
    "build": "mwtsc --cleanOutDir",
    "dev:pack": "cross-env NODE_ENV=local lerna run build &&  cross-env NODE_ENV=local npx watchBootstrap --watch --run @midwayjs/mock/app"
  },
