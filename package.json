    "@midwayjs/captcha": "3",
    "@midwayjs/core": "^3.20.11",
    "@midwayjs/i18n": "3",
    "@midwayjs/info": "^3.20.12",
    "@midwayjs/koa": "^3.20.12",
    "@midwayjs/logger": "^3.4.2",
    "@midwayjs/redis": "^3.20.11",
    "@midwayjs/swagger": "^3.20.12",
    "@midwayjs/validate": "^3.20.12",
    "@sequelize/core": "7.0.0-alpha.46",
    "@sequelize/postgres": "7.0.0-alpha.46",
    "@sequelize/utils": "7.0.0-alpha.46",
    "dayjs": "^1.11.13",
    "dotenv": "^16.6.1",
    "lodash-es": "^4.17.21",
    "midway-vite-view": "^2.1.2",
    "swagger-ui-dist": "^5.27.1",
    "tsx": "^4.20.5",
    "vite": "^6.3.5"
