{
  "name": "my-midway-esm-project",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "type": "module",
  "bin": {
    "watchBootstrap": "./bin/watchBootstrap.js"
  },
  "dependencies": {
    "@meadmin/core": "workspace:^",
    "@midwayjs/bootstrap": "^3.20.4",
    "@midwayjs/core": "^3.20.4",
    "@midwayjs/info": "^3.20.4",
    "@midwayjs/koa": "^3.20.4",
    "@midwayjs/logger": "^3.4.2",
    "@midwayjs/swagger": "3",
    "@midwayjs/validate": "^3.20.4",
    "@sequelize/core": "7.0.0-alpha.46",
    "@sequelize/postgres": "7.0.0-alpha.46",
    "swagger-ui-dist": "^5.21.0",
    "tsx": "^4.19.3"
  },
  "devDependencies": {
    "@midwayjs/mock": "^3.20.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^16.18.126",
    "c8": "^8.0.1",
    "cross-env": "^7.0.3",
    "lerna": "^8.2.2",
    "mocha": "^10.8.2",
    "mwts": "^1.3.0",
    "mwtsc": "^1.15.1",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "scripts": {
    "start": "cross-env NODE_ENV=production node ./bootstrap.js",
    "dev": "cross-env NODE_ENV=local  mwtsc --watch --run @midwayjs/mock/app",
    "test": "cross-env NODE_ENV=unittest TSX_TSCONFIG_PATH=./test/tsconfig.json mocha",
    "cov": "cross-env c8 --all --reporter=text --reporter=lcovonly npm run test",
    "lint": "mwts check",
    "lint:fix": "mwts fix",
    "ci": "npm run cov",
    "build": "mwtsc --cleanOutDir",
    "dev:pack": "cross-env NODE_ENV=local lerna run build &&  cross-env NODE_ENV=local npx watchBootstrap --watch --run @midwayjs/mock/app"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
