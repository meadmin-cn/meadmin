{
  "name": "meadmin",
  "version": "1.3.0",
  "description": "",
  "private": true,
  "type": "module",
  "dependencies": {
    "@meadmin/cli": "workspace:^",
    "@meadmin/core": "workspace:^",
    "@meadmin/midway-vite-view": "workspace:^",
    "@midwayjs/bootstrap": "^3.20.22",
    "@midwayjs/busboy": "^3.20.22",
    "@midwayjs/cache-manager": "^3.20.22",
    "@midwayjs/captcha": "^3.20.22",
    "@midwayjs/core": "^3.20.22",
    "@midwayjs/i18n": "^3.20.22",
    "@midwayjs/info": "^3.20.22",
    "@midwayjs/koa": "^3.20.22",
    "@midwayjs/logger": "^3.4.2",
    "@midwayjs/redis": "^3.20.22",
    "@midwayjs/static-file": "^3.20.22",
    "@midwayjs/swagger": "^3.20.22",
    "@midwayjs/validate": "^3.20.22",
    "@sequelize/core": "7.0.0-alpha.47",
    "@sequelize/postgres": "7.0.0-alpha.47",
    "@sequelize/utils": "7.0.0-alpha.47",
    "dayjs": "^1.11.19",
    "dotenv": "^16.6.1",
    "lodash-es": "^4.17.21",
    "swagger-ui-dist": "^5.30.2",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.8.1",
    "@commitlint/config-conventional": "^17.8.1",
    "@eslint/js": "10.0.1",
    "@midwayjs/mock": "^3.20.22",
    "@release-it/conventional-changelog": "^8.0.2",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/lodash-es": "^4.17.12",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.14.0",
    "c8": "^8.0.1",
    "cross-env": "^7.0.3",
    "eslint": "10.1.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-node": "^11.1.0",
    "globals": "17.4.0",
    "husky": "^8.0.3",
    "lerna": "^8.2.4",
    "lint-staged": "^13.3.0",
    "mocha": "^10.8.2",
    "mwts": "^1.3.0",
    "mwtsc": "^1.15.2",
    "prettier": "3.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "release-it": "^17.11.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.58.0",
    "vite": "~8.0.8"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "start": "cross-env NODE_ENV=prod node ./bootstrap.js",
    "dev": "cross-env NODE_ENV=local  npx me-devBootstrap --cleanOutDir --watch --run @midwayjs/mock/app",
    "test": "cross-env NODE_ENV=unittest TSX_TSCONFIG_PATH=./test/tsconfig.json mocha",
    "cov": "cross-env c8 --all --reporter=text --reporter=lcovonly npm run test",
    "lint": "eslint . --cache && pnpm -F *-template run lint",
    "lint:fix": "eslint . --fix && pnpm -F *-template run lint",
    "prettier": "prettier --cache  -l \"./**/*.{js,ts,vue,json}\"",
    "prettier:fix": "prettier --write --cache  -l \"./**/*.{js,ts,vue,json}\"",
    "ci": "npm run cov",
    "build": "mwtsc --cleanOutDir && vite-view build",
    "type-check": "mwtsc --noEmit && pnpm -F *-template run type-check",
    "dev:pack": "cross-env NODE_ENV=local lerna run build &&  cross-env NODE_ENV=local npx me-watchBootstrap --watch --run @midwayjs/mock/app",
    "release": "release-it"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "author": "yuntian001",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/meadmin-cn/meadmin"
  },
  "lint-staged": {
    "**/*": "prettier --cache --write --ignore-unknown",
    "*.ts": "eslint --cache --fix"
  }
}
