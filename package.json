{
  "name": "my-midway-esm-project",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "type": "module",
  "bin": {
    "watchBootstrap": "./bin/watchBootstrap.js"
  },
  "dependencies": {
    "@meadmin/core": "workspace:^",
    "@midwayjs/bootstrap": "^3.16.6",
    "@midwayjs/core": "^3.16.2",
    "@midwayjs/info": "^3.16.8",
    "@midwayjs/koa": "^3.16.8",
    "@midwayjs/logger": "^3.1.0",
    "@midwayjs/validate": "^3.16.8"
  },
  "devDependencies": {
    "@midwayjs/mock": "^3.16.5",
    "@types/mocha": "^10.0.1",
    "@types/node": "16",
    "c8": "^8.0.1",
    "cross-env": "^7.0.3",
    "lerna": "^8.1.2",
    "mocha": "^10.2.0",
    "mwts": "^1.3.0",
    "mwtsc": "^1.10.1",
    "ts-node": "^10.9.2",
    "typescript": "~5.1.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "scripts": {
    "start": "cross-env NODE_ENV=production node ./bootstrap.js",
    "dev": "cross-env NODE_ENV=local  mwtsc --watch --run @midwayjs/mock/app",
    "test": "cross-env NODE_ENV=unittest mocha",
    "cov": "cross-env c8 --all --reporter=text --reporter=lcovonly npm run test",
    "lint": "mwts check",
    "lint:fix": "mwts fix",
    "ci": "npm run cov",
    "build": "mwtsc --cleanOutDir",
    "watch:pack": "cross-env NODE_ENV=local npx watchBootstrap --watch --run @midwayjs/mock/app"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
