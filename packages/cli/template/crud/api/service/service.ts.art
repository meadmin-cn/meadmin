import { BadRequestError } from '@midwayjs/core/dist/error/http.js';
import { InjectRepository } from '@/decorators/index.js';
import { Provide, Inject } from '@midwayjs/core';
import { {{@ replaceNames.CreateDto}} } from '{{@ paths.createDtoPath}}';
import { {{@ replaceNames.QueryDto}} } from '{{@ paths.queryDtoPath}}';
import { {{@ replaceNames.UpdateDto}} } from '{{@ paths.updateDtoPath}}';
import { {{@ replaceNames.Name}} } from '{{@ paths.entityPath}}';
import { MidwayI18nService } from '@midwayjs/i18n';
import { Transaction } from '@/decorators/index.js';
import { Op } from '@sequelize/core';{{each $imports.objectKeys(entity.belongsToEntity)}}<% const valueEnitty = entity.belongsToEntity[$value]; %>{{if ['File'].includes(valueEnitty.entityName)}}<% return; %>{{/if}}
import { {{@ valueEnitty.entityName}} } from '{{@ paths.entityPath.replace(replaceNames.name,valueEnitty.entityFileName)}}';{{/each}}{{each $imports.objectKeys(entity.belongsToManyEntity)}}<% const valueEnitty = entity.belongsToManyEntity[$value]; %>{{if ['File'].includes(valueEnitty.entityName)}}<% return; %>{{/if}}
import { {{@ valueEnitty.entityName}} } from '{{@ paths.entityPath.replace(replaceNames.name,valueEnitty.entityFileName)}}';{{/each}}

{{if entity.pk.length > 1}}type PK = {
  {{each entity.pk}}
  {{@ $value}}: {{@ entitySchema.properties[$value].type}},
  {{/each}}
}{{/if}}
//{{@ entity.tableComment}}
@Provide()
export class {{@ replaceNames.Service}} {
  @InjectRepository({{@ replaceNames.Name}})
  {{@ replaceNames.name}}Repository: typeof {{@ replaceNames.Name}}
  
  @Inject()
  i18nService: MidwayI18nService;
  <% const hasStatement = ['File']; %>
  {{each $imports.objectKeys(entity.belongsToEntity).filter(v=>v!='File')}}<% const valueEnitty = entity.belongsToEntity[$value]; %>{{if hasStatement.includes(valueEnitty.entityName)}}<% return; %>{{else}}<% hasStatement.push(valueEnitty.entityName);%>{{/if}}
  //查询belongsTo关联模型{{@ $value}}{{@ valueEnitty.tableComment}}
  @InjectRepository({{@ valueEnitty.entityName}})
  {{@ valueEnitty.entityFileName}}Repository: typeof {{@ valueEnitty.entityName}}

 /**
   * 获取{{@ valueEnitty.tableComment}}信息
   * @param queryDto
   * @returns
   */
  @Transaction()
  async get{{@ valueEnitty.entityName}}(page:number,pageSize:number,{{@ valueEnitty.pk[0]}}:{{@ swaggerSchemas[valueEnitty.entityName]?.properties?.[entity.pk[0]]?.type || 'string'}}{{if valueEnitty.nameKeys.length}},{{@ valueEnitty.nameKeys[0]}}: string = '', {{/if}}) {
    const where = {};
    if({{@ valueEnitty.pk[0]}}){
      where['{{@ valueEnitty.pk[0]}}'] = {{@ valueEnitty.pk[0]}};
    }
    {{if valueEnitty.nameKeys.length}}if({{@ valueEnitty.nameKeys[0]}}){
      where['{{@ valueEnitty.nameKeys[0]}}'] =  { [Op.like]: '%'+{{@ valueEnitty.nameKeys[0]}}+'%' };
    }{{/if}}
    const { count, rows } = await this.{{@ replaceNames.name}}Repository.findAndCountAll({
      where,
      offset: (page - 1) *  pageSize,
      limit: pageSize,
    });
    return {
      list: rows,
      total: count,
      page: page,
      pageSize: pageSize,
    };
  }{{/each}}
  
  {{each $imports.objectKeys(entity.belongsToManyEntity).filter(v=>v!='File')}}<% const valueEnitty = entity.belongsToManyEntity[$value]; %>{{if hasStatement.includes(valueEnitty.entityName)}}<% return; %>{{else}}<% hasStatement.push(valueEnitty.entityName);%>{{/if}}
  //查询belongsToMany关联模型{{@ $value}}{{@ valueEnitty.tableComment}}
  @InjectRepository({{@ valueEnitty.entityName}})
  {{@ valueEnitty.entityFileName}}Repository: typeof {{@ valueEnitty.entityName}}

  /**
   * 获取{{@ valueEnitty.tableComment}}信息
   * @param queryDto
   * @returns
   */
  @Transaction()
  async get{{@ valueEnitty.entityName}}(page:number,pageSize:number,{{@ valueEnitty.pk[0]}}:{{@ swaggerSchemas[valueEnitty.entityName]?.properties?.[entity.pk[0]]?.type || 'string'}}{{if valueEnitty.nameKeys.length}},{{@ valueEnitty.nameKeys[0]}}: string = '', {{/if}}) {
    const where = {};
    if({{@ valueEnitty.pk[0]}}){
      where['{{@ valueEnitty.pk[0]}}'] = {{@ valueEnitty.pk[0]}};
    }
    {{if valueEnitty.nameKeys.length}}if({{@ valueEnitty.nameKeys[0]}}){
      where['{{@ valueEnitty.nameKeys[0]}}'] =  { [Op.like]: '%'+{{@ valueEnitty.nameKeys[0]}}+'%' };
    }{{/if}}
    const { count, rows } = await this.{{@ replaceNames.name}}Repository.findAndCountAll({
      where,
      offset: (page - 1) *  pageSize,
      limit: pageSize,
    });
    return {
      list: rows,
      total: count,
      page: page,
      pageSize: pageSize,
    };
  }{{/each}}

  /**
   * 创建数据
   * @param createDto
   * @returns
   */
  @Transaction()
  async create(createDto: {{@ replaceNames.CreateDto}}) {
    const entity = this.{{@ replaceNames.name}}Repository.build(createDto);
    return await entity.save();
  }

  /**
   * 列表分页查询
   * @param queryDto 查询条件
   * @returns
   */
  @Transaction()
  async list(queryDto: {{@ replaceNames.QueryDto}}) {
    const where = {};
    Object.keys(queryDto).forEach((key) => {
      if(['page', 'pageSize'].includes(key)){
        return;
      }
      if([null, undefined, ''].includes(queryDto[key])){
        return;
      }{{each entitySchema.properties}}{{if $index.endsWith('At')}}
      if (key === 'start{{@ $imports.upFirstCase($index)}}') {
        where['{{@ $index}}'] = where['{{@ $index}}'] ?? {};
        where['{{@ $index}}'][Op.gte] = queryDto[key];
        return;
      }
      if (key === 'end{{@ $imports.upFirstCase($index)}}') {
        where['{{@ $index}}'] = where['{{@ $index}}'] ?? {};
        where['{{@ $index}}'][Op.lte] = queryDto[key];
        return;
      }{{/if}}{{/each}}
      where[key] = queryDto[key];
    });    
    const { count, rows } = await this.{{@ replaceNames.name}}Repository.findAndCountAll({
      where,
      offset: (queryDto.page - 1) *  queryDto.pageSize,
      limit: queryDto.pageSize,
      {{if $imports.objectKeys(entitySchema.properties).includes('createdAt')}}order: [['createdAt', 'DESC']],
    {{/if}}})
    return {
      list: rows,
      total: count,
      page: queryDto.page,
      pageSize: queryDto.pageSize,
    };
  }

  /**
   * 根据主键获取一条信息
   * @param {{if entity.pk.length > 1}}pk{{else}}{{@ entity.pk[0]}}{{/if}} 主键
   * @returns
   */
  @Transaction()
  async findOne({{if entity.pk.length > 1}}pk:PK{{else}}{{@ entity.pk[0]}}: {{@ entitySchema.properties[entity.pk[0]].type}}{{/if}}) {
    const entity = await this.{{@ replaceNames.name}}Repository.findByPk({{if entity.pk.length > 1}}pk{{else}}{{@ entity.pk[0]}}{{/if}});
    if (!entity) {
      throw new BadRequestError(this.i18nService.translate('没有对应的信息'));
    }
    return entity;
  }

  /**
   * 更新数据
   * @param {{if entity.pk.length > 1}}pk{{else}}{{@ entity.pk[0]}}{{/if}} 主键
   * @param updateDto 数据对象
   * @returns
   */
  @Transaction()
  async update({{if entity.pk.length > 1}}pk:PK{{else}}{{@ entity.pk[0]}}: {{@ entitySchema.properties[entity.pk[0]].type}}{{/if}}, updateDto: {{@ replaceNames.UpdateDto}}) {
    const entity = await this.{{@ replaceNames.name}}Repository.findByPk({{if entity.pk.length > 1}}pk{{else}}{{@ entity.pk[0]}}{{/if}});
    if (!entity) {
      throw new BadRequestError(this.i18nService.translate('没有对应的信息'));
    }
    Object.assign(entity, updateDto);
    return await entity.save();
  }

  /**
   * 删除数据
   * @param {{if entity.pk.length > 1}}pk{{else}}{{@ entity.pk[0]}}{{/if}} 主键
   * @returns
   */
  @Transaction()
  async remove({{if entity.pk.length > 1}}pk:PK{{else}}{{@ entity.pk[0]}}: {{@ entitySchema.properties[entity.pk[0]].type}}{{/if}}) {
    const entity = await this.{{@ replaceNames.name}}Repository.findByPk({{if entity.pk.length > 1}}pk{{else}}{{@ entity.pk[0]}}{{/if}});
    if (!entity) {
      throw new BadRequestError(this.i18nService.translate('没有对应的信息'));
    }
    await entity.destroy();
  }
}
