<template>
  <me-dialog v-loading="loading" v-model="show" :title="t(info.{{entity.pk[0]}} ? '编辑' : '新增')" :close-on-click-modal="false"
    @closed="$emit('closed')">
    <el-form ref="formEl" :model="info" :rules="rules" class="add" label-width="auto">
      <% include('./addOrUpItem.vue.art', {...entitySchema, entity:entity}) %>
    </el-form>
    <template #footer>
      <me-button type="primary" @click="submit">{{$imports.leftTag()}} t('提交') {{$imports.rightTag()}}</me-button>
      <me-button @click="() => show = false">{{$imports.leftTag()}} t('取消') {{$imports.rightTag()}}</me-button>
    </template>
  </me-dialog>
</template>

<script setup lang="ts" name="AddOrUp{{replaceNames.Name}}">
import { {{replaceNames.Name}}, {{replaceNames.Name}}Info, add{{replaceNames.Name}}Api, update{{replaceNames.Name}}Api, {{replaceNames.name}}InfoApi } from '@/api/{{replaceNames.name}}';
import { useLocalesI18n } from '@/locales/i18n';
import { resetObj<% if($imports.objectValues(entitySchema.properties).some(v=>v.enum || v.description.includes(':'))){%>, formatterStr<%}%> } from '@/utils/helper';
import { FormInstance, FormRules } from 'element-plus';
{{if $imports.objectValues(entitySchema.properties).some(value=>value.rule?._rules.some(v=>v.name==='mobile'))}}import { isMobile } from '@/utils/validate.js'{{/if}}<% include('../dict.ts.art', {...entitySchema, entity:entity, replaceNames:replaceNames}) %>
let { t } = useLocalesI18n({}, [(locale: string) => import(`../lang/${locale}.json`), '{{replaceNames.name}}']);
const show = defineModel<boolean>();
const props = defineProps<{
  {{each entity.pk}}
  {{$value}}?: {{entitySchema.properties[$value].type}};
  {{/each}}
}>();
const emit = defineEmits<{
  (e: 'success'): void;
  (e: 'closed'): void;
}>();
const info = reactive(new {{replaceNames.Name}}());
const loading = ref(false);
watch(
  () => {{if entity.pk.length===1}}props.{{entity.pk[0]}}{{else}}[props.{{entity.pk.join(', props.')}}]{{/if}},
  async ({{entity.pk.map(v=>`${v}?:${entitySchema.properties[v].type}`).join(', ')}}) => {
    if ({{entity.pk[0]}}) {
      loading.value = true;
      resetObj(info, await {{replaceNames.name}}InfoApi().runAsync({{entity.pk.join(', ')}}));
      loading.value = false;
    }
  },
  { immediate: true },
);
const rules: FormRules = {
  <% include('./rules.ts.art', {...entitySchema}) %>
};
const formEl = ref<FormInstance>();
const submit = async () => {
  try {
    await formEl.value!.validate();
  } catch (invalidFields) {
    return formEl.value!.scrollToField(Object.keys(invalidFields!)[0]);
  }
  if (props.{{entity.pk[0]}}) {
    await update{{replaceNames.Name}}Api().runAsync(props.{{entity.pk.join(', props.')}}, info);
  } else {
    await add{{replaceNames.Name}}Api().runAsync(info);
  }
  show.value = false;
  emit('success');
}
</script>
