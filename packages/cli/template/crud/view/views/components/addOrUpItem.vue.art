{{each properties}}<% const keyInfo = $imports.getKeyInfo($value.description); %>{{if ['number','string','integer'].includes($value.type)}}
<el-form-item :label="t('{{keyInfo.name}}')" prop="{{$index}}">
  {{if $value.enum || keyInfo.dict}}<el-select v-model="info.{{$index}}">
    <el-option v-for="val in dict.{{$index}}" :key="val.value" :value="val.value">{{$imports.leftTag()}}val.label{{$imports.rightTag()}}</el-option>
  </el-select>
  {{else if ['number','integer'].includes($value.type)}}
    <el-input-number v-model="info.{{$index}}" ></el-input-number>
  {{else if $value.type === 'string'}}
    <el-input v-model="info.{{$index}}" ></el-input>  
  {{/if}}
</el-form-item>{{else if $value.type==='boolean'}}
<el-form-item :label="t('{{keyInfo.name}}')" prop="{{$index}}">
  <el-switch v-model="info.{{$index}}" />
</el-form-item>{{/if}}{{/each}}