{{each $value.rule._rules $val $key}}
{{if $val.name === 'email'}}{ type: 'email', message: t('{{keyInfo.name}}')+t('必须是正确的邮箱格式'), trigger: 'blur' },{{/if}}
{{if $val.name === 'mobile'}}{validator:(rule, value:string|number)=>isMobile(value), message: t('{{keyInfo.name}}')+t('必须是正确的手机号'), trigger: 'blur'},{{/if}}
{{if $val.name === 'url'}}{ type: 'url', message: t('{{keyInfo.name}}')+t('必须是正确的链接格式'), trigger: 'blur' },{{/if}}
{{if $val.name === 'length'}}{ type: '{{$value.type}}',len:{{$val.args.limit}},  message: t('{{keyInfo.name}}')+t('长度必须为 {len}',{ len:{{$val.args.limit}} }), trigger: 'blur' },{{/if}}
{{/each}}