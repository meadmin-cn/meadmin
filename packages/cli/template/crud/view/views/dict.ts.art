<% if($imports.objectKeys(properties).some(k=>properties[k].enum || properties[k].description.includes(':'))){%>import { VxeColumnPropTypes } from 'vxe-table';
const dict = {
{{each properties}}<% const keyInfo = $imports.getKeyInfo($value.description);%>{{if keyInfo.dict}}
 {{$index}}:{
  {{each keyInfo.dict val key}}'{{key}}':{value:{{if $value.type==='string'}}'{{/if}}{{key}}{{if $value.type==='string'}}'{{/if}}, label:'{{val}}'},{{/each}}
  },{{else if $value.enum}}
  {{$index}}:{
  {{each $value.enum val key}}'{{val}}':{value:{{if $value.type==='string'}}'{{/if}}{{val}}{{if $value.type==='string'}}'{{/if}}, label:'{{val}}'},{{/each}}
  },
{{/if}}{{/each}}
};
const formatterDict: VxeColumnPropTypes.Formatter<{{replaceNames.Name}}Info> = ({ cellValue, column }) => {
  //因为ts类型判定不得不断言dict
  return formatterStr({ cellValue: (dict as Record<string,any>)[column.field]?.[cellValue as string]?.label });
}
<%}%>
