<template>
  <page>
    <me-search-form :model="params" :default-all="true" class="search-form" @search="search(1)" #searchForm>
      <% include('./searchItem.vue.art', {...entitySchema, entity:entity}) %>
    </me-search-form>
    <me-vxe-table
    :loading="loading"
    :data="data?.list"
    :pagination-options="{
      currentPage: params.page,
      pageSize: params.size,
      total: data?.total ?? 0,
      layout: 'sizes, prev, pager, next, jumper, ->, total',
      change: search,
    }"
    align="center"
    border
    @refresh="search(1)"
    @add="showAddOrUp()"
  >
    <% include('./tableColum.vue.art', {...entitySchema, entity:entity}) %>
    <vxe-column :title="t('操作')" fixed="right" min-width="150px">
      <template #default="{ row }: { row: {{replaceNames.Name}}Info }">
        <el-button @click="showAddOrUp(row.id!)">
          <mel-icon-edit />
        </el-button>
        <el-popconfirm :title="t('确认删除？')" placement="left" @confirm="del(row.id!)">
          <template #reference>
            <el-button :key="row.id!" :loading="delLoading && delId === row.id" type="danger">
              <mel-icon-delete />
            </el-button>
          </template>
        </el-popconfirm>
      </template>
    </vxe-column>
    </me-vxe-table>    
  </page>
</template>

<script setup lang="ts" name="{{replaceNames.Name}}">
import { {{replaceNames.name}}ListApi, {{replaceNames.Name}}ListParam, del{{replaceNames.Name}}Api, {{replaceNames.Name}}Info } from '@/api/{{replaceNames.name}}';
import { useLocalesI18n } from '@/locales/i18n';
import AddOrUp from './components/addOrUp.vue';
import { useActionModel } from '@/hooks/index.js';
import {formatterStr} from '@/utils/helper.js';
<% include('./dict.ts.art', {...entitySchema, entity:entity, replaceNames:replaceNames}) %>
const {open} = useActionModel(AddOrUp);
let { t } = useLocalesI18n({}, [(locale: string) => import(`./lang/${locale}.json`), '{{replaceNames.name}}']);
const params = reactive(new {{replaceNames.Name}}ListParam());
const { loading, data, runAsync } = {{replaceNames.name}}ListApi();
const search = (page = params.page, size = params.size) => runAsync(Object.assign(params, { page, size }));
const { runAsync: delRun, loading: delLoading } = del{{replaceNames.Name}}Api();
const delId = ref<string>();
const del = async (id: string) => {
  delId.value = id;
  await delRun(id);
  await search(1);
};
const showAddOrUp = (id?: string) => {
  open({id,onSuccess:async ()=>{
    await search(1);
  }});
};
await search(1);
</script>

