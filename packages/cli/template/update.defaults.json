{
  "skipExisting": {
    "view/index/src/views/index/**": true,
    "view/admin/src/views/index/**": true,
    "public/**": true,
    "uploadFile/**": true,
    "view/*/public/**": true,
    "addons/**": true,
    "src/app/*/addons/**": true,
    "view/*/src/addons/**": true
  },
  "exclude": {
    "**/.git/**": true,
    "**/.workbuddy/**": true,
    "**/.meadmin/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/logs/**": true,
    "**/pnpm-lock.yaml": true,
    "**/package-lock.json": true,
    "**/yarn.lock": true,
    "**/*.tsbuildinfo": true
  },
  "autoIntegration": true,
  "defaultPolicy": "overwrite",
  "templateMappings": {
    "**/packageTemplate.json": "package.json"
  },
  "sql": {
    "enabled": true,
    "generateOnSameVersion": false,
    "source": "meadmin.sql",
    "output": "update.sql",
    "originalName": "meadmin-{version}.sql"
  },
  "mergeSource": {
    "**/package.json": "package",
    "**/entities/**/*.ts": "entity",
    "**/src/config/**/*.ts": "config",
    "**/.env*": "manual",
    "**/.env": "env",
    "**/.env.?*": "env",
    "**/pnpm-workspace.{yaml,yml}": "yaml",
    "**/tsconfig*.json": "json",
    "**/{nx,turbo,.mocharc,.prettierrc,.eslintrc}.json": "json",
    "**/.prettierrc": "json",
    "**/.vscode/*.json": "json",
    "**/.npmrc": "npmrc",
    "**/{.gitignore,.npmignore,.prettierignore,.eslintignore}": "ignore",
    "**/*.config.{js,ts,cjs,mjs,cts,mts}": "script",
    "**/{.prettierrc,.eslintrc,.mocharc}.{js,ts,cjs,mjs,cts,mts}": "script",
    "**/{.editorconfig,.yarnrc,.yarnrc.*,.pnpmfile,.pnpmfile.*,.eslintrc,.mocharc}": "manual",
    "**/{.eslintrc,.mocharc}.!(json|js|ts|cjs|mjs|cts|mts)": "manual",
    "view/index/src/router/**/*.ts": "routes",
    "src/ruleType/**/*.ts": "validation",
    "src/ruleType/index.ts": false,
    "src/api/**/*.ts": "functions",
    "src/utils/**/*.ts": "functions",
    "src/helper/**/*.ts": "functions",
    "src/decorators/index.ts": "exports",
    "view/admin/src/store/module.ts": "exports",
    "view/index/src/store/module.ts": "exports",
    "view/admin/src/event/module.ts": "exports",
    "view/admin/src/api/**/*.ts": "functions",
    "view/admin/src/utils/**/*.ts": "functions",
    "view/admin/src/helper/**/*.ts": "functions",
    "view/index/src/api/**/*.ts": "functions",
    "view/index/src/utils/**/*.ts": "functions",
    "view/index/src/helper/**/*.ts": "functions",
    "src/filter/index.ts": "exports"
  }
}
