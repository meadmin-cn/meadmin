{
  "name": "@meadmin/core",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "dist/index.js",
  "typings": "index.d.ts",
  "bin": {
    "me-watchBootstrap": "bin/watchBootstrap.js",
    "me-devBootstrap": "bin/devBootstrap.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "index.d.ts"
  ],
  "dependencies": {
    "tsx": "^4.20.5"
  },
  "devDependencies": {
    "@midwayjs/mock": "^3.20.11",
    "@types/mocha": "^10.0.10",
    "@types/node": "^16.18.126",
    "c8": "^8.0.1",
    "cross-env": "^7.0.3",
    "lerna": "^8.2.3",
    "lodash-es": "^4.17.21",
    "mocha": "^10.8.2",
    "prettier": "2.8.8",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "@midwayjs/bootstrap": ">=3.20.11 3.x",
    "@midwayjs/core": ">=3.20.11 3.x",
    "@midwayjs/info": ">=3.20.12 3.x",
    "@midwayjs/koa": ">=3.20.12 3.x",
    "@midwayjs/logger": ">=3.4.2 3.x",
    "@midwayjs/validate": ">=3.20.12 3.x",
