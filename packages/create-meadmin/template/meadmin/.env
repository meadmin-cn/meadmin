# 启动模式 ALL | ONLY_WORKER | ONLY_API，调试时使用ALL，部署建议，注释掉MODE，分别部署网站进程（在部署命令设 MODE = ONLY_API），队列进程（在部署命令设 MODE = ONLY_WORKER）
MODE = ALL
# 网站标题
WEBSITE_NAME = Me - Admin
#启动端口
SERVER_PORT=7001

#数据库
#数据库连接地址
DATABASE_HOST=
#数据库端口
DATABASE_PORT=
#数据库名称
DATABASE_DB=
#数据库模式
DATABASE_SCHEMA=
#数据库用户名
DATABASE_USER=
#数据库密码
DATABASE_PASSWORD=


#redis缓存
#redis地址
REDIS_HOST=
#redis端口
REDIS_PORT=
#redis密码
REDIS_PASS=
#缓存对应的redis库
REDIS_CACHE=0
#消息队列对应的redis库
REDIS_MQ=1

#管理后台路由前缀
VIEW_ADMIN_PATH_PRE=/admin

#前台路由前缀
VIEW_INDEX_PATH_PRE=
#前台服务端渲染api前缀
VIEW_INDEX_API_SERVER_PREFIX=http://127.0.0.1:7001/api/index/
#前台客户端端渲染api前缀
VIEW_INDEX_API_CLIENT_PREFIX=/api/index/

