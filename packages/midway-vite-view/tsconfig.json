{
  "extends": "../../tsconfig.json",
  "compileOnSave": true,
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "baseUrl": "."
  },
  "paths": {
    "@/*": ["./src/*"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "index.d.ts",
    "bin/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "test"
  ]
}
